# Copiez ce fichier en .env et remplissez les valeurs.

# Base de données (SQLite par défaut, suffisant pour le MVP)
DATABASE_URL=sqlite:///./astro.db

# Clé API Anthropic, nécessaire pour générer les lectures interprétées.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour la génération des lectures.
ANTHROPIC_MODEL=claude-sonnet-5

# Nom du cookie de session anonyme et durée de vie (en jours).
SESSION_COOKIE_NAME=astro_session
SESSION_TTL_DAYS=365

# Origines autorisées pour CORS (utile si un frontend séparé consomme l'API).
CORS_ORIGINS=*
